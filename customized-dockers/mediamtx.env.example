# mediamtx config on the shared PVC: copy to <PVC>/config/mediamtx.env
# (management pod: /pvc-live/config/mediamtx.env; live pods: /pvc/live/config/mediamtx.env),
# edit, then restart the live pods. Exported to mediamtx and its hooks (abr.sh, send-kafka.sh).
# Values here win over the pod env; HOSTNAME is kept from the pod.
# mediamtx.yml next to this file replaces the image's /mediamtx.yml.
# Format: KEY=VALUE, sourced by /bin/sh: quote values with spaces, $ or &.

# mediamtx.yml overrides (any key as MTX_<KEY>), replaces the CHANGE-ME values
MTX_AUTHJWTJWKS=http://livestream-service.arena:8080/internal/authorization/jwks.json
MTX_AUTHHTTPADDRESS='http://livestream-service.arena:8080/internal/mediamtx/auth?internal_token=change-me'

# abr.sh (ABR ffmpeg, runOnAvailable)
JAVA_URL=http://livestream-service.arena:8080
INTERNAL_TOKEN=change-me
ABR_ROOT=/dev/shm/abr
ABR_CACHE_DIR=/tmp/abr-cache

# send-kafka.sh -> go-rest /events
EVENTS_URL=http://127.0.0.1:8753/events
